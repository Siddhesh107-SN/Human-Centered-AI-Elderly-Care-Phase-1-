# Server Settings
PROJECT_NAME="CarePulse AI - Human-Centered Elderly Care"
VERSION=2.0.0
PORT=8000
HOST=0.0.0.0

# MySQL Database Connection
# Dedicated user recommended (never run as root in production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=elderly_care_db
MYSQL_USER=elderly_care_user
MYSQL_PASSWORD=ElderlyCare@2026

# Application Security
SECRET_KEY=carepulse_elderly_care_ai_super_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
